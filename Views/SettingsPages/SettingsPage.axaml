<ci:SettingsPageBase
    x:Class="TeacherNotifier.Views.SettingsPages.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="14">

            <TextBlock Text="连接设置" FontSize="18" FontWeight="Bold" />

            <StackPanel Spacing="6">
                <TextBlock Text="连接模式" Opacity="0.7" />
                <ComboBox SelectedIndex="{Binding ConnectionMode}" HorizontalAlignment="Left" MinWidth="220">
                    <ComboBoxItem Content="HTTP POST 上报" />
                    <ComboBoxItem Content="反向 WebSocket" />
                </ComboBox>

                <TextBlock Text="监听端口" Opacity="0.7" />
                <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Increment="1"
                                HorizontalAlignment="Left" Width="160" />

                <TextBlock Text="访问令牌（NapCat 连接生成的 Token，留空则不校验）" Opacity="0.7" />
                <TextBox Text="{Binding AccessToken}" Watermark="留空表示不校验" />

                <TextBlock Text="NapCat HTTP API 地址（用于查备注，留空则不查）" Opacity="0.7" />
                <TextBox Text="{Binding NapCatApiUrl}" Watermark="http://127.0.0.1:18801" />

                <TextBlock Text="NapCat HTTP API Token（WebUI 里 HTTP 服务器配置的 token）" Opacity="0.7" />
                <TextBox Text="{Binding NapCatApiToken}" Watermark="留空表示无 token" />

                <TextBlock Text="手动备注映射（QQ号=备注名，逗号分隔，最可靠不依赖 API）" Opacity="0.7" />
                <TextBox Text="{Binding RemarkMap}" Watermark="例如：123456789=王老师,987654321=李老师" />

                <TextBlock Text="老师 QQ 白名单（英文逗号分隔，留空则不限制发送者）" Opacity="0.7" />
                <TextBox Text="{Binding TeacherQQs}" Watermark="例如：123456789,987654321" />

                <TextBlock Text="群号白名单（英文逗号分隔，留空 = 所有群）" Opacity="0.7" />
                <TextBox Text="{Binding GroupIds}" Watermark="例如：123456789" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding AllowAllWhenEmpty}" />
                    <TextBlock Text="白名单为空时接收所有消息" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding IgnoreSelfMessages}" />
                    <TextBlock Text="忽略机器人自己发送的消息" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Separator />

            <TextBlock Text="通知设置" FontSize="18" FontWeight="Bold" />

            <StackPanel Spacing="6">
                <TextBlock Text="标题模板（{name}=备注/昵称，{remark}=备注，{qq}=QQ号，{group}=群号，{message}=内容）" Opacity="0.7" />
                <TextBox Text="{Binding TitleTemplate}" />

                <TextBlock Text="标题显示时长（秒）" Opacity="0.7" />
                <NumericUpDown Value="{Binding TitleDuration}" Minimum="0.5" Maximum="60" Increment="0.5"
                                HorizontalAlignment="Left" Width="160" />

                <TextBlock Text="正文显示时长（秒）" Opacity="0.7" />
                <NumericUpDown Value="{Binding BodyDuration}" Minimum="1" Maximum="300" Increment="1"
                                HorizontalAlignment="Left" Width="160" />

                <TextBlock Text="正文滚动重复次数（越大滚动越快）" Opacity="0.7" />
                <NumericUpDown Value="{Binding BodyRepeatCount}" Minimum="1" Maximum="20" Increment="1"
                                HorizontalAlignment="Left" Width="160" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding SpeechEnabled}" />
                    <TextBlock Text="启用语音朗读" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="语音朗读模板" Opacity="0.7" />
                <TextBox Text="{Binding SpeechTemplate}" />
            </StackPanel>

            <TextBlock
                Text="改完即时生效。请在 NapCat 中把上报地址设为 http://127.0.0.1:{端口}/（HTTP 模式）或 ws://127.0.0.1:{端口}/（WebSocket 模式）。"
                TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
        </StackPanel>
    </ScrollViewer>

</ci:SettingsPageBase>
