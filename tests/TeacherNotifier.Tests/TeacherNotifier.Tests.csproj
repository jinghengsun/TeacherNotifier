<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TeacherNotifier.Tests</RootNamespace>
    <AssemblyName>TeacherNotifier.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- 测试台用不到 null 容忍度警告 -->
    <NoWarn>CS8618</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 不用默认通配：本项目位于插件项目目录下的 tests/ 子目录，
         默认通配（**/*.cs）会向上匹配到插件项目的源文件与 obj 生成文件，
         导致两个项目互相把对方的 AssemblyInfo 编进自己的程序集（CS0579）。
         改为显式列出文件，边界清晰。 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试台自身文件 -->
    <Compile Include="Program.cs" />
    <Compile Include="TestKit.cs" />
    <Compile Include="Fakes\FakeBotApi.cs" />

    <!-- 被测源码直接编译进测试程序集。
         这样既不需要引用 ClassIsland SDK / Avalonia（只有插件本体需要），
         也让 internal 成员（如 NapCatConnectionService.InvalidateCachesForTest）可直接调用。 -->
    <Compile Include="..\..\Models\AppSettings.cs" Link="Plugin\AppSettings.cs" />
    <Compile Include="..\..\Services\TeacherMessage.cs" Link="Plugin\TeacherMessage.cs" />
    <Compile Include="..\..\Services\NapCatApiClient.cs" Link="Plugin\NapCatApiClient.cs" />
    <Compile Include="..\..\Services\NapCatConnectionService.cs" Link="Plugin\NapCatConnectionService.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本与 ClassIsland 2.0.4 / 2.1.x 提供的程序集一致，避免测试环境与生产环境行为不一致 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
